# ============================================================================
# CyberWithSteve ACOP - environment configuration
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env is git-ignored and MUST NOT be committed. Nothing in this file is a real
# credential. Every setting is prefixed ACOP_ so that ACOP's variables cannot
# collide with anything else on the host.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ACOP_APP_NAME="CyberWithSteve ACOP"
# development | test | staging | production
ACOP_ENVIRONMENT=development
ACOP_DEBUG=false

ACOP_API_HOST=0.0.0.0
ACOP_API_PORT=8000
# Set when served behind a reverse proxy at a sub-path, e.g. /acop
ACOP_API_ROOT_PATH=

# Swagger UI at /docs. Milestone 1 uses this as the primary interface, so it is
# on by default. Turn it off before exposing ACOP beyond the lab.
ACOP_DOCS_ENABLED=true

# JSON array or comma-separated list. Leave empty to disable CORS entirely.
ACOP_CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ACOP_LOG_LEVEL=INFO
# json for shipping to a log pipeline, console for local readability
ACOP_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# PostgreSQL
#
# ACOP_POSTGRES_HOST is overridden to "postgres" by docker-compose for the
# containers. Set it to 127.0.0.1 when running the API outside compose.
# ---------------------------------------------------------------------------
ACOP_POSTGRES_HOST=127.0.0.1
ACOP_POSTGRES_PORT=5432
ACOP_POSTGRES_USER=acop
# Generate one:  openssl rand -base64 32
ACOP_POSTGRES_PASSWORD=CHANGE_ME_generate_a_random_password
ACOP_POSTGRES_DB=acop

# Host port for the database, bound to loopback only.
ACOP_POSTGRES_PUBLISHED_PORT=5432
# Host port for the API.
ACOP_API_PUBLISHED_PORT=8000
ACOP_IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Ollama / local inference
#
# Ollama runs on the GPU host, separate from the ACOP application host. Set
# this to that machine's address. Do NOT use localhost unless you are running
# ACOP directly on the GPU host outside a container.
# ---------------------------------------------------------------------------
ACOP_OLLAMA_BASE_URL=http://CHANGE_ME_gpu_host:11434

# The exact tag as reported by `ollama list` on the GPU host. Pin the tag -
# a bare model name will resolve by prefix and report as degraded, on purpose.
ACOP_OLLAMA_MODEL=qwen3:32b

# Control-plane calls (version, model list, health). Keep this short.
ACOP_OLLAMA_CONTROL_TIMEOUT_SECONDS=5
# Inference calls. A long reasoning turn on a 3090 can take minutes.
ACOP_OLLAMA_GENERATE_TIMEOUT_SECONDS=300

# Context window requested on every call.
#
# IMPORTANT: Ollama applies its own default (historically 4096 tokens) when the
# caller does not set num_ctx, and silently truncates the prompt to fit. For a
# platform that reasons over retrieved evidence, silent truncation is
# indistinguishable from hallucination. Raise this as far as VRAM allows, and
# check `nvidia-smi` after changing it: a ~32B model at Q4 already occupies most
# of a 24 GB card, and KV cache for a large context comes out of what is left.
# If the model starts spilling to system RAM, throughput will collapse.
ACOP_OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model resident after a request. Longer avoids
# repeated multi-second model loads; shorter frees the GPU for other work.
ACOP_OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------
# Dependency probes are cached this long, so a monitoring scrape interval
# cannot turn /health into a load generator against the GPU host.
ACOP_HEALTH_CACHE_TTL_SECONDS=10

# ---------------------------------------------------------------------------
# Authentication
#
# Milestone 1 mechanism only. The Principal abstraction is provider-neutral;
# an identity provider is added later as an additional backend without any
# change to audit, incident, change, approval or tool-execution records.
#
# ACOP_API_KEYS is a JSON array. Fields:
#   subject       Opaque, STABLE identifier for the actor. If this principal
#                 later authenticates via an identity provider, map that
#                 provider's subject claim onto this same string so historical
#                 audit records stay attributable. Do not use an email address
#                 or a username that might change.
#   secret        The API key itself. Generate one: openssl rand -hex 32
#   display_name  Human-readable label. Never used for authorisation.
#   roles         ACOP's own vocabulary: admin | approver | operator | viewer
#   principal_type  human | service | agent
#
# Present the key as:  X-ACOP-API-Key: <secret>
#                 or:  Authorization: Bearer <secret>
# ---------------------------------------------------------------------------
ACOP_AUTH_ENABLED=true
ACOP_API_KEY_HEADER=X-ACOP-API-Key
ACOP_API_KEYS=[{"subject":"acop:user:steve","secret":"CHANGE_ME_openssl_rand_hex_32","display_name":"Steve White","roles":["admin"],"principal_type":"human"}]

# ---------------------------------------------------------------------------
# Test-suite toggles (leave unset for normal operation)
# ---------------------------------------------------------------------------
# Set to 1 to run integration tests against a live PostgreSQL.
# ACOP_TEST_DATABASE=1
# Set to 1 to run the live inference test against the real Ollama host.
# ACOP_TEST_OLLAMA=1
